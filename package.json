{
  "name": "ng-speed-test",
  "version": "4.0.0",
  "description": "Angular library for testing internet connection speed",
  "readme": "README.md",
  "homepage": "https://ng-speed-test.jrquick.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jrquick17/ng-speed-test"
  },
  "bugs": {
    "url": "https://github.com/jrquick17/ng-speed-test/issues"
  },
  "main": "fesm2022/ng-speed-test.mjs",
  "module": "fesm2022/ng-speed-test.mjs",
  "fesm2022": "fesm2022/ng-speed-test.mjs",
  "typings": "index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./index.d.ts",
      "node": "./fesm2022/ng-speed-test.mjs",
      "default": "./fesm2022/ng-speed-test.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "ng build ng-speed-test",
    "postbuild": "node scripts/strip-published-engines.mjs",
    "build:watch": "ng build ng-speed-test --watch",
    "build:link": "npm run build && cd dist/ng-speed-test && npm link",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:demo": "tsc --noEmit -p projects/demo/tsconfig.app.json",
    "verify": "npm run lint && npm run test && npm run build && npm run demo:build",
    "demo": "ng serve demo",
    "demo:build": "ng build demo --configuration production",
    "docs": "npm run docs:build",
    "docs:build": "compodoc -p tsconfig.json -n ng-speed-test -d docs --hideGenerator",
    "docs:serve": "npm run docs:build -- -s",
    "docs:watch": "npm run docs:build -- -s -w",
    "lint": "ng lint ng-speed-test && ng lint demo",
    "test": "ng test ng-speed-test --watch=false",
    "test:watch": "ng test ng-speed-test --watch",
    "pack": "npm run build && npm pack ./dist/ng-speed-test --pack-destination ./dist/ng-speed-test",
    "release": "npm run build && npm publish ./dist/ng-speed-test",
    "release:dry": "npm run build && npm publish ./dist/ng-speed-test --dry-run",
    "prepublishOnly": "echo ng-speed-test: do not publish from the repo root - use npm run release && exit 1",
    "preshipit": "git diff --quiet HEAD",
    "shipit": "npm run lint && npm run test && npm run build && npm run demo:build && npm run docs:build && npm run release",
    "shipit:dry": "npm run lint && npm run test && npm run build && npm run demo:build && npm run docs:build && npm run release:dry",
    "clean": "rimraf dist/ng-speed-test",
    "restore:dist": "git checkout -- dist docs && git clean -fd dist docs",
    "clean:all": "rimraf dist/ng-speed-test node_modules && npm ci"
  },
  "keywords": [
    "angular",
    "speed-test",
    "internet-speed",
    "network-test",
    "bandwidth",
    "connection-speed",
    "typescript",
    "rxjs",
    "angular20",
    "angular21",
    "angular22"
  ],
  "author": "Jeremy Quick",
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "rxjs": "^7.5.0",
    "tslib": "^2.3.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/animations": "22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cdk": "22.1.3",
    "@angular/cli": "22.1.5",
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/compiler-cli": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/material": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/platform-browser-dynamic": "22.1.0",
    "@angular/router": "22.1.3",
    "@compodoc/compodoc": "^2.0.0",
    "@types/node": "^26.3.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.0.0",
    "rimraf": "^6.0.0",
    "rxjs": "^7.8.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "zone.js": "~0.15.1"
  }
}