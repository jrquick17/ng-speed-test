{
  "name": "ng-speed-test",
  "version": "3.2.3",
  "description": "Angular library for testing internet connection speed",
  "readme": "README.md",
  "homepage": "https://ng-speed-test.jrquick.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jrquick17/ng-speed-test"
  },
  "bugs": {
    "url": "https://github.com/jrquick17/ng-speed-test/issues"
  },
  "main": "fesm2022/ng-speed-test.mjs",
  "module": "fesm2022/ng-speed-test.mjs",
  "fesm2022": "fesm2022/ng-speed-test.mjs",
  "typings": "index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./index.d.ts",
      "node": "./fesm2022/ng-speed-test.mjs",
      "default": "./fesm2022/ng-speed-test.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "ng build ng-speed-test",
    "postbuild": "node scripts/strip-published-engines.mjs",
    "build:watch": "ng build ng-speed-test --watch",
    "build:link": "npm run build && cd dist/ng-speed-test && npm link",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:demo": "tsc --noEmit -p projects/demo/tsconfig.app.json",
    "verify": "npm run test && npm run build && npm run demo:build",
    "demo": "ng serve demo",
    "demo:build": "ng build demo --configuration production",
    "docs": "npm run docs:build",
    "docs:build": "compodoc -p tsconfig.json -n ng-speed-test -d docs --hideGenerator",
    "docs:serve": "npm run docs:build -- -s",
    "docs:watch": "npm run docs:build -- -s -w",
    "lint": "echo ng-speed-test: no lint target yet - see .claude/work/CHECKLIST.md B1 && exit 1",
    "test": "ng test ng-speed-test --watch=false",
    "test:watch": "ng test ng-speed-test --watch",
    "pack": "npm run build && npm pack ./dist/ng-speed-test --pack-destination ./dist/ng-speed-test",
    "release": "npm run build && npm publish ./dist/ng-speed-test",
    "release:dry": "npm run build && npm publish ./dist/ng-speed-test --dry-run",
    "prepublishOnly": "echo ng-speed-test: do not publish from the repo root - use npm run release && exit 1",
    "preshipit": "git diff --quiet HEAD",
    "shipit": "npm run test && npm run build && npm run demo:build && npm run docs:build && npm run release",
    "shipit:dry": "npm run test && npm run build && npm run demo:build && npm run docs:build && npm run release:dry",
    "clean": "rimraf dist/ng-speed-test",
    "restore:dist": "git checkout -- dist docs && git clean -fd dist docs",
    "clean:all": "rimraf dist/ng-speed-test node_modules && npm ci"
  },
  "keywords": [
    "angular",
    "speed-test",
    "internet-speed",
    "network-test",
    "bandwidth",
    "connection-speed",
    "typescript",
    "rxjs",
    "angular19",
    "angular20"
  ],
  "author": "Jeremy Quick",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@angular/common": "^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
    "@angular/core": "^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
    "rxjs": "^7.5.0",
    "tslib": "^2.3.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.32",
    "@angular/animations": "20.3.27",
    "@angular/build": "20.3.32",
    "@angular/cdk": "20.2.14",
    "@angular/cli": "20.3.32",
    "@angular/common": "20.3.27",
    "@angular/compiler": "20.3.27",
    "@angular/compiler-cli": "20.3.27",
    "@angular/core": "20.3.27",
    "@angular/forms": "20.3.27",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.27",
    "@angular/platform-browser-dynamic": "20.3.27",
    "@angular/router": "20.3.27",
    "@compodoc/compodoc": "^1.1.25",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.0.0",
    "angular-eslint": "19.8.1",
    "eslint": "^9.28.0",
    "jasmine-core": "~5.1.0",
    "jsdom": "^30.0.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.0.0",
    "rimraf": "^6.0.0",
    "rxjs": "^7.8.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "8.33.1",
    "vitest": "^3.2.7",
    "zone.js": "~0.15.1"
  }
}
